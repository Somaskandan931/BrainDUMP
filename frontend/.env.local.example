# Copy to .env.local. FastAPI backend from Milestones 1-6.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Identity Services Web client id (Google Cloud Console -> OAuth
# client, type "Web application"). Leave unset to hide the Google button
# and use email/password only. Must match backend GOOGLE_LOGIN_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth App client id (not the secret -- that stays backend-only).
# Leave unset to hide the GitHub button. Must match backend GITHUB_CLIENT_ID.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Optional override; defaults to `${origin}/auth/github/callback` at
# runtime, which is correct for almost every deployment. Must exactly
# match backend GITHUB_OAUTH_REDIRECT_URI and the GitHub OAuth App's own
# configured callback URL.
NEXT_PUBLIC_GITHUB_REDIRECT_URI=
