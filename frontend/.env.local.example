# Copy to .env.local. FastAPI backend from Milestones 1-6.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Identity Services Web client id (Google Cloud Console -> OAuth
# client, type "Web application"). Leave unset to hide the Google button
# and use email/password only. Must match backend GOOGLE_LOGIN_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
