# Copy to .env at the repo root for local dev. Never commit the real .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (required: set to a long random string) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Per-user Google Calendar (optional; omit to disable the integration) ---
# Google Cloud Console -> Credentials -> OAuth client ID -> "Web application".
# Add GOOGLE_CALENDAR_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback
FRONTEND_URL=http://localhost:3000
# Encrypts each user's stored Google token. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Sign in with Google (optional; also set NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend)
GOOGLE_LOGIN_CLIENT_ID=

# --- Sign in with GitHub (optional; omit both frontend+backend vars to hide the button) ---
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI
# below AND the frontend's NEXT_PUBLIC_GITHUB_REDIRECT_URI (or, if that's
# left unset, `<your frontend origin>/auth/github/callback`).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# --- Email (optional; omit to log verification/reset emails instead of sending them) ---
# Any SMTP provider works (SES, Postmark, Mailgun, Gmail app password, etc).
# Leave SMTP_HOST unset for local dev -- emails are logged, not sent, so the
# verify-email / password-reset flows still work end to end without any setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 = implicit TLS (port 465). Leave 0 for STARTTLS on port 587 (the default).
SMTP_USE_SSL=0
EMAIL_FROM_ADDRESS=no-reply@braindump.app
EMAIL_FROM_NAME=BrainDUMP
# 1 = /api/auth/login rejects unverified password accounts. Leave 0 until
# SMTP is actually configured above, or nobody will be able to sign in.
EMAIL_VERIFICATION_REQUIRED=0

# --- Redis (optional; omit to use the in-memory rate limiter) ---
# Set this once you run more than one API process/instance, so login/
# register/email-action rate limits are shared instead of each process
# counting separately. e.g. redis://localhost:6379/0
REDIS_URL=

# --- Error monitoring (optional; omit for stdout-only structured logs) ---
# From your Sentry project's Settings -> Client Keys.
SENTRY_DSN=
# Tags Sentry events; also read for other environment-specific behavior.
ENVIRONMENT=development
# Fraction of requests also captured as performance traces (0.0-1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Audit trail retention ---
# The nightly job deletes each user's activity_log rows older than this many
# days. 0 keeps everything (the table then grows without bound).
ACTIVITY_LOG_RETENTION_DAYS=180
