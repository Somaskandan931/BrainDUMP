# Copy to .env at the repo root for local dev. Never commit the real .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (required: set to a long random string) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Per-user Google Calendar (optional; omit to disable the integration) ---
# Google Cloud Console -> Credentials -> OAuth client ID -> "Web application".
# Add GOOGLE_CALENDAR_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback
FRONTEND_URL=http://localhost:3000
# Encrypts each user's stored Google token. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Sign in with Google (optional; also set NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend)
GOOGLE_LOGIN_CLIENT_ID=

# --- Sign in with GitHub (optional; omit both frontend+backend vars to hide the button) ---
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI
# below AND the frontend's NEXT_PUBLIC_GITHUB_REDIRECT_URI (or, if that's
# left unset, `<your frontend origin>/auth/github/callback`).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
